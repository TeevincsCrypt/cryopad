# Solana RPC & Network Configuration
# Default to Mainnet or Devnet
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Pump.fun Launch Requirements & Configuration
# Minimum SOL balance in wallet to qualify for launching (configurable, default 15 SOL)
VITE_MIN_LAUNCH_BALANCE_SOL=15.0

# Pinata / IPFS / Decentralized Storage (Optional for custom IPFS pinning)
PINATA_JWT=
PINATA_GATEWAY=

# Server Configuration
PORT=3000
NODE_ENV=development
