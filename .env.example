# AgentRouter AI Configuration (OpenAI-compatible)
# Base URL: https://co.agentrouter.org/v1
# Consumes AgentRouter credits server-side; never exposed to browser
AGENTROUTER_API_KEY=

# Solana RPC & Network Configuration
# Default to Mainnet or Devnet
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Pump.fun Launch Requirements & Configuration
# Minimum wallet balance required in USD worth of SOL to qualify for launching (default $15.00 USD)
VITE_MIN_LAUNCH_BALANCE_USD=15.0

# Pinata / IPFS / Decentralized Storage (Optional for custom IPFS pinning)
PINATA_JWT=
PINATA_GATEWAY=

# Server Configuration
PORT=3000
NODE_ENV=development
